# ════════════════════════════════════════════════════════════════
# QMS App — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ════════════════════════════════════════════════════════════════

# ── Database (Supabase PostgreSQL) ──────────────────────────────
# Session-mode connection string (port 5432) — use this for migrations
# Transaction-mode pooler (port 6543) can be used for high-concurrency prod
POSTGRES_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Set to "false" only for local non-Supabase Postgres (disables SSL)
POSTGRES_SSL=true

# Connection pool tuning (optional)
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_MS=30000
POSTGRES_CONNECT_MS=5000

# ── NextAuth.js ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set to your public URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── OAuth — Google ──────────────────────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── OAuth — GitHub ──────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Auth0 ────────────────────────────────────────────────────────
# https://manage.auth0.com → Applications → your app → Settings
# Allowed Callback URLs: {NEXTAUTH_URL}/api/auth/callback/auth0
# Allowed Logout URLs: {NEXTAUTH_URL}
# Allowed Web Origins: {NEXTAUTH_URL}
AUTH_AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH_AUTH0_ID=
AUTH_AUTH0_SECRET=

# ── Magic Link Email (Resend) ───────────────────────────────────
# https://resend.com — leave blank to disable magic link sign-in
AUTH_RESEND_KEY=
EMAIL_FROM="QMS <noreply@yourdomain.com>"

# ── AWS S3 Storage ──────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=qms-app-uploads

# Optional: CloudFront CDN URL for serving files (no trailing slash)
# AWS_S3_CDN_URL=https://d1234567890.cloudfront.net

# ── Logging ─────────────────────────────────────────────────────
# Options: debug | info | warn | error  (default: info in prod, debug in dev)
LOG_LEVEL=info

# ── Event bus / cron (Integrated System) ────────────────────────
# Shared secret guarding the outbox-sweep cron route (/api/events/process).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=
